# ESP32-S3 核心板，沿用现有 ESP-IDF 5.5.3 环境
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 内建1500KB应用分区，摄像头驱动需要更大空间；NVS与应用起始地址不变
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# V0.24 ESP32-S3-WROOM-1-N16R8: 8MB Octal PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Leave internal DMA/task memory available while buffering FHD TCP traffic.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# This N16R8 build requires its fitted PSRAM for FHD frames and Wi-Fi TX caching.
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32

# SCCB shares I2C0 with XL9555; the camera module supplies its own 24MHz XCLK
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_CLK_FREQ=100000
CONFIG_LWIP_MAX_SOCKETS=16
# One FHD JPEG is about 50KiB; avoid serializing it through a four-MSS TX window.
# Keep the RX window and Wi-Fi buffer counts unchanged; watch internal heap.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=57600

# UART0 控制台，115200 波特率
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# 保持早期实验的 1 ms 系统节拍
CONFIG_FREERTOS_HZ=1000
