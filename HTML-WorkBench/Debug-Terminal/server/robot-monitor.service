[Unit]
Description=Robot dog telemetry and web monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/robot-monitor
EnvironmentFile=%h/.config/robot-monitor/receiver.env
ExecStart=/usr/bin/python3 %h/robot-monitor/robot_server.py --host 0.0.0.0 --port 8080 --data-dir %h/robot-monitor/data
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
